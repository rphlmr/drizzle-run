{
  "name": "drizzle-run",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/rphlmr/drizzle-run#readme",
  "bugs": {
    "url": "https://github.com/rphlmr/drizzle-run/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rphlmr/drizzle-run.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build && node scripts/finalize-build.ts",
    "build:packages": "turbo run build --filter=!@drizzle-run/app",
    "changeset": "changeset",
    "check:guides": "GUIDES_CHECK=1 pnpm exec playwright test -c playwright.guides.config.ts guides.generate",
    "clean:all": "node scripts/clean-all.ts",
    "db:check": "pnpm --filter @drizzle-run/app run db:check && pnpm --filter @drizzle-run/app run db:check:store",
    "db:check:store": "pnpm --filter @drizzle-run/app run db:check:store",
    "db:generate": "pnpm --filter @drizzle-run/app run db:generate",
    "db:generate:store": "pnpm --filter @drizzle-run/app run db:generate:store",
    "db:migrate": "pnpm --filter @drizzle-run/app run db:migrate",
    "db:seed": "pnpm --filter @drizzle-run/app run db:seed",
    "db:up": "pnpm --filter @drizzle-run/app run db:up && pnpm --filter @drizzle-run/app run db:up:store",
    "dev": "pnpm run build:packages && node --experimental-strip-types apps/drizzle-run/scripts/serve-drizzle-run.ts --vite",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "guests:catalog": "node scripts/guests/generate.ts",
    "guests:check": "node scripts/guests/generate.ts --check",
    "guests:generate": "turbo run guests:catalog",
    "guests:install": "node scripts/guests/install.ts",
    "guests:new": "node scripts/guests/new.ts",
    "guests:sync": "node scripts/guests/lock.ts && turbo run guests:catalog",
    "lint": "turbo run lint:workspace",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:workspace": "oxlint --type-aware",
    "preview": "pnpm run build && node --experimental-strip-types apps/drizzle-run/scripts/serve-drizzle-run.ts",
    "record:official": "pnpm exec playwright test -c playwright.guides.config.ts official-recordings.generate",
    "replay:guides": "pnpm exec playwright test -c playwright.guides.config.ts guides.generate",
    "runtime-assets": "turbo run build --filter=@drizzle-run/runtime",
    "studio": "pnpm --filter @drizzle-run/app run studio",
    "test": "turbo run test test:worker",
    "test:deployed": "pnpm exec playwright test -c playwright.deployed.config.ts",
    "test:e2e": "pnpm exec playwright test --project chromium",
    "test:e2e:all": "pnpm exec playwright test",
    "test:pack": "turbo run test:pack",
    "test:runtime": "node testing/capability-harness/src/gates/acceptance.gate.ts && node testing/capability-harness/src/gates/kit-parity.gate.ts && node testing/capability-harness/src/gates/ownership.gate.ts",
    "test:sdk-api": "node scripts/audit-sdk-api.ts",
    "test:stress": "pnpm exec playwright test -c playwright.stress.config.ts",
    "typecheck": "pnpm run typecheck:scripts && turbo run typecheck typecheck:worker typecheck:e2e",
    "typecheck:e2e": "turbo run typecheck:e2e",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "pkg-pr-new": "0.0.91",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.17.0"
}
