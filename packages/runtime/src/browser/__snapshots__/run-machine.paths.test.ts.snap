// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`browser run machine paths > should take the same transitions 1`] = `
[
  "idle --run.start--> {"active":"starting"}",
  "idle --run.cancel--> cancelled",
  "idle --execution.ready--> idle",
  "idle --execution.phase--> idle",
  "{"active":"starting"} --run.start--> {"active":"starting"}",
  "{"active":"starting"} --run.cancel--> {"active":"cancelling"}",
  "{"active":"starting"} --execution.ready--> {"active":"running"}",
  "{"active":"starting"} --execution.phase--> {"active":"starting"}",
  "{"active":"starting"} --done(execute) succeeded--> succeeded",
  "{"active":"starting"} --done(execute) with a failed execution--> failed",
  "{"active":"starting"} --done(execute) with an invalid database report--> failed",
  "{"active":"starting"} --error(execute)--> failed",
  "cancelled --run.start--> cancelled",
  "cancelled --run.cancel--> cancelled",
  "cancelled --execution.ready--> cancelled",
  "cancelled --execution.phase--> cancelled",
  "{"active":"cancelling"} --run.start--> {"active":"cancelling"}",
  "{"active":"cancelling"} --run.cancel--> {"active":"cancelling"}",
  "{"active":"cancelling"} --execution.ready--> {"active":"cancelling"}",
  "{"active":"cancelling"} --execution.phase--> {"active":"cancelling"}",
  "{"active":"cancelling"} --done(execute) succeeded--> cancelled",
  "{"active":"cancelling"} --done(execute) with a failed execution--> cancelled",
  "{"active":"cancelling"} --done(execute) with an invalid database report--> cancelled",
  "{"active":"cancelling"} --error(execute)--> cancelled",
  "{"active":"running"} --run.start--> {"active":"running"}",
  "{"active":"running"} --run.cancel--> {"active":"cancelling"}",
  "{"active":"running"} --execution.ready--> {"active":"running"}",
  "{"active":"running"} --execution.phase--> {"active":"running"}",
  "{"active":"running"} --done(execute) succeeded--> succeeded",
  "{"active":"running"} --done(execute) with a failed execution--> failed",
  "{"active":"running"} --done(execute) with an invalid database report--> failed",
  "{"active":"running"} --error(execute)--> failed",
  "succeeded --run.start--> succeeded",
  "succeeded --run.cancel--> succeeded",
  "succeeded --execution.ready--> succeeded",
  "succeeded --execution.phase--> succeeded",
  "failed --run.start--> failed",
  "failed --run.cancel--> failed",
  "failed --execution.ready--> failed",
  "failed --execution.phase--> failed",
]
`;
