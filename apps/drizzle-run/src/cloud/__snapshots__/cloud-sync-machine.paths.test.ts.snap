exports[`cloud sync machine paths > a cycle that fails with account_changed paths > should take the same transitions 1`] = `
[
  "signedOut account=null --account.set--> syncing account=1 dirty=false cycleWrite="none"",
  "syncing account=1 dirty=false cycleWrite="none" --account.set--> syncing account=1 dirty=false cycleWrite="none"",
  "syncing account=1 dirty=false cycleWrite="none" --error(runCycle) account_changed--> endingSession account=1",
  "endingSession account=1 --account.set--> endingSession account=1",
  "endingSession account=1 --done(0.cloudSync.endingSession)--> signedOut account=null",
  "endingSession account=1 --error(runCycle) account_changed--> sessionFailed account=1",
  "sessionFailed account=1 --account.set--> sessionFailed account=1",
]
`;

