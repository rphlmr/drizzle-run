{
  "name": "@drizzle-run/app",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/rphlmr/drizzle-run/tree/main/apps/drizzle-run#readme",
  "bugs": {
    "url": "https://github.com/rphlmr/drizzle-run/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rphlmr/drizzle-run.git",
    "directory": "apps/drizzle-run"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:embed": "tsc -p tsconfig.embed.json && node scripts/build-embed.ts",
    "check:type-walk": "node scripts/check-type-walk.ts",
    "db:check": "drizzle-kit check && node scripts/check-d1-schema.ts",
    "db:check:store": "drizzle-kit check --config drizzle.store.config.ts && node scripts/check-store-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:store": "drizzle-kit generate --config drizzle.store.config.ts",
    "db:migrate": "node scripts/migrate-d1.ts",
    "db:seed": "pnpm run db:migrate && node scripts/seed-d1.ts",
    "db:up": "drizzle-kit up",
    "db:up:store": "drizzle-kit up --config drizzle.store.config.ts",
    "dev": "vite --host",
    "dev:https": "vite --host --mode local-https --port 5173 --strictPort",
    "generate:examples": "node scripts/build-example-index.ts",
    "generate:guides": "node scripts/build-guides.ts",
    "generate:og-images": "node scripts/build-og-images.ts",
    "prebuild": "pnpm run build:embed && pnpm run generate:guides && pnpm run generate:examples && pnpm run generate:og-images",
    "predev": "pnpm run build:embed && pnpm run generate:guides && pnpm run generate:examples && pnpm run generate:og-images",
    "preview": "vite preview",
    "release": "node --experimental-strip-types scripts/release-drizzle-run.ts",
    "studio": "drizzle-kit studio",
    "test": "vitest run && pnpm run test:embed",
    "test:embed": "vitest run --config vitest.embed.config.ts --coverage",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json && tsc -p guides/tsconfig.json && tsc -p og/tsconfig.json && node scripts/build-guides.ts --check && node scripts/build-example-index.ts --check",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "typecheck:worker": "tsc -p worker/tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@drizzle-run/core": "workspace:*",
    "@drizzle-run/orchestration": "workspace:*",
    "@drizzle-run/react": "workspace:*",
    "@drizzle-run/runtime": "workspace:*",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@hono/standard-validator": "0.4.0",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@xstate/react": "6.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "1.0.0-rc.5",
    "es-toolkit": "1.52.0",
    "hono": "4.13.13",
    "lucide-react": "1.61.0",
    "mermaid": "12.2.0",
    "monaco-editor": "0.57.0",
    "onedollarstats": "0.0.23",
    "pino": "10.4.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.8",
    "react-router": "8.5.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261022.1",
    "@drizzle-run/machine-paths": "workspace:*",
    "@drizzle-run/test-fixtures": "workspace:*",
    "@libsql/client": "0.18.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "1.0.0-rc.5",
    "esbuild": "0.28.2",
    "satori": "0.63.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
